# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_ALLOWED_HOSTS=itrtv.bj,www.itrtv.bj

# Base de données (utilisée en prod / si tu actives MySQL en dev)
DB_NAME=itr_tv
DB_USER=itr_tv_user
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=3306

# Front-end
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Cloudinary (stockage médias — cahier des charges §8)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (notifications de contact, mot de passe oublié)
# Par défaut (non renseigné) : les emails s'affichent dans la console au lieu d'être envoyés.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@itrtv.bj
